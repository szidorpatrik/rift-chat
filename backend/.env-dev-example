# --- Database ---
POSTGRES_USER="riftchat_user_dev"
POSTGRES_PASSWORD=development-password # No quotes around passwords!
POSTGRES_DB="riftchat_db_dev"
POSTGRES_PORT="5432"
POSTGRES_SSLMODE="disable"

# --- Backend ---
BACKEND_HTTP_PORT="8081"
BACKEND_QUIC_PORT="4242"
BACKEND_PLATFORM="dev"
BACKEND_LISTEN_ADDR="0.0.0.0"
BACKEND_VALKEY_HOST="127.0.0.1"
# Generate a random key with `openssl rand -base64 64` and paste it below.
BACKEND_JWT_SECRET=""
BACKEND_DATABASE_URL="host=127.0.0.1 port=${POSTGRES_PORT} user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} dbname=${POSTGRES_DB} sslmode=${POSTGRES_SSLMODE}"

# --- Valkey ---
BACKEND_VALKEY_PORT="6379"